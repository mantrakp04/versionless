{
  "name": "versionless",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6",
      "@types/bun": "^1.3.14",
      "@types/node": "^22.13.14",
      "elysia": "^1.4.29",
      "@trpc/server": "^11.18.0",
      "@orpc/server": "^1.14.8",
      "@orpc/client": "^1.14.8",
      "lucide-react": "^1.23.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.7",
      "react-dom": "^19.2.7",
      "sonner": "^2.0.7",
      "@trpc/client": "^11.18.0",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.3.2",
      "hono": "^4.9.0",
      "express": "^5.1.0",
      "@types/express": "^5.0.0",
      "expect-type": "^1.2.2",
      "@clickhouse/client-web": "^1.12.1"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev versionless:watch",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "start-deps": "docker compose up -d",
    "stop-deps": "docker compose down",
    "restart-deps": "docker compose down -v && bun run start-deps && turbo run db:generate && turbo run db:push && bun run --cwd apps/server seed",
    "dev:dashboard": "turbo run dev -F dashboard",
    "dev:landing": "turbo run dev -F landing",
    "dev:server": "turbo run dev versionless:watch -F server",
    "versionless:check": "bun run --cwd apps/demo versionless:check && bun run --cwd apps/server versionless:check",
    "versionless:watch": "bun run --cwd apps/demo versionless:watch",
    "db:push": "turbo run db:push -F @versionless/db",
    "db:studio": "turbo run db:studio -F @versionless/db",
    "db:generate": "turbo run db:generate -F @versionless/db",
    "db:check": "turbo run db:check -F @versionless/db",
    "db:migrate": "turbo run db:migrate -F @versionless/db",
    "otel:validate": "bun test infra/otel/render-envoy-config.test.ts && docker build --build-arg ENVOY_TARGET=local -f infra/otel/envoy.Dockerfile -t versionless-envoy:validate-local . && docker build --build-arg ENVOY_TARGET=railway -f infra/otel/envoy.Dockerfile -t versionless-envoy:validate-railway .",
    "deploy:setup": "vercel link",
    "dev:vercel": "vercel dev -L",
    "env:preview": "tsx scripts/sync-vercel-env.ts preview",
    "env:production": "tsx scripts/sync-vercel-env.ts production",
    "deploy": "vercel deploy",
    "deploy:prod": "vercel deploy --prod",
    "deploy:check": "vercel deploy --dry"
  },
  "dependencies": {
    "@versionless/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@hexclave/js": "^1.0.52",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@versionless/config": "workspace:*",
    "railway": "3.5.9",
    "tsx": "^4.22.5",
    "turbo": "^2.10.2",
    "typescript": "catalog:",
    "vercel": "^54.18.6"
  },
  "packageManager": "bun@1.3.14"
}
