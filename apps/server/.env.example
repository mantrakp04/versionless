# Optional in development (defaults to the dashboard at http://localhost:3001);
# required in production unless the Vercel origin applies.
CORS_ORIGIN=
DATABASE_URL=
CLICKHOUSE_URL=
CLICKHOUSE_DATABASE=versionless
CLICKHOUSE_QUERY_PASSWORD=
POSTGRES_QUERY_PASSWORD=
# OpenAI-compatible endpoint for the dashboard assistant. Optional: defaults
# to http://localhost:8317/v1 locally and OpenRouter in production.
AI_BASE_URL=
AI_API_KEY=
# Optional: defaults to gpt-5.6-luna locally and OpenRouter's
# openai/gpt-5.6-luna slug in production.
AI_MODEL=
VERSIONLESS_API_URL=http://localhost:3000
VERSIONLESS_OTLP_LOGS_URL=http://localhost:4318/v1/logs
HEXCLAVE_PROJECT_ID=
HEXCLAVE_SECRET_SERVER_KEY=
DEMO_VERSIONLESS_API_KEY=
