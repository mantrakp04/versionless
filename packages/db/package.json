{
  "name": "@versionless/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio --port ${PORT_PREFIX:-30}12",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "bun scripts/check-migrations.ts",
    "check-types": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@versionless/env": "workspace:*",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "@versionless/config": "workspace:*",
    "drizzle-kit": "^0.31.10",
    "typescript": "catalog:"
  }
}
